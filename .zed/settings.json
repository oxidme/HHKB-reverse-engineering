// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "enable_language_server": true,
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "C": {
      // clangd picks up compile_flags.txt and .clang-format from the project root.
      "language_servers": ["clangd"],
      "hard_tabs": false,
      "tab_size": 4,
      "preferred_line_length": 100,
    },
    "Python": {
      "language_servers": ["ruff", "..."],
      "formatter": [{ "code_action": "source.fixAll.ruff" }, "language_server"],
      "tab_size": 4,
      "preferred_line_length": 100,
    },
  },
  "file_types": {
    // Dumped keymaps and firmware images are binary; keep them out of the
    // file finder so searches stay on the sources.
    "Binary": ["*.bin", "*.BIN"],
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/dumps",
    "**/dumps_*",
  ],
}
